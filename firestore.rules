rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- BASIC HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'zr3xo1dZ3Ghqy8e7OnbnTPumM0i1' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true)
      );
    }

    function isClinicAdmin(clinicId) {
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super-admin'] ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true)
      );
    }

    function isClinicMember(clinicId) {
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId
      );
    }

    // --- VALIDATION HELPERS ---

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'clinicId', 'companyCode', 'role', 'name'])
        && data.email is string && data.email.size() <= 200
        && data.clinicId is string && data.clinicId.size() <= 128
        && data.role in ['admin', 'professional', 'receptionist', 'super-admin']
        && data.name is string && data.name.size() <= 200;
    }

    function isValidClinic(data) {
      return data.keys().hasAll(['name', 'companyCode', 'ownerId', 'specialty', 'createdAt'])
        && data.name is string && data.name.size() <= 200
        && data.companyCode is string && data.companyCode.size() <= 50
        && data.ownerId == request.auth.uid
        && data.specialty in ['dentist', 'medical', 'aesthetic', 'general']
        && data.createdAt == request.time;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['name'])
        && data.name is string && data.name.size() <= 200;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'professionalId', 'startTime', 'endTime', 'status'])
        && data.patientId is string
        && data.professionalId is string
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.status in ['scheduled', 'confirmed', 'completed', 'cancelled', 'no-show'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['type', 'amount', 'date', 'status'])
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.date is timestamp
        && data.status in ['pending', 'received', 'cancelled'];
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidClinic(request.resource.data);
      allow update: if isClinicAdmin(clinicId) && isValidClinic(request.resource.data);

      match /patients/{patientId} {
        allow read: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId) && isValidPatient(request.resource.data);
        allow update: if isClinicMember(clinicId) && isValidPatient(request.resource.data);
        allow delete: if isClinicAdmin(clinicId);
      }

      match /appointments/{appointmentId} {
        allow read: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId) && isValidAppointment(request.resource.data);
        allow update: if isClinicMember(clinicId) && isValidAppointment(request.resource.data);
        allow delete: if isClinicAdmin(clinicId);
      }

      match /healthRecords/{recordId} {
        allow read: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId);
        allow update: if isClinicAdmin(clinicId);
      }

      match /transactions/{transactionId} {
        allow read: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId) && isValidTransaction(request.resource.data);
        allow update: if isClinicAdmin(clinicId) && isValidTransaction(request.resource.data);
        allow delete: if isClinicAdmin(clinicId);
      }

      match /professionals/{professionalId} {
        allow read: if isClinicMember(clinicId);
        allow create, update: if isClinicAdmin(clinicId);
      }
    }

    // --- GLOBAL SAFETY NET ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
