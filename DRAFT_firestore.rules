rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL SAFETY NET ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- BASIC HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isDev() {
      return isSignedIn() && (
        request.auth.uid == 'zr3xo1dZ3Ghqy8e7OnbnTPumM0i1' ||
        request.auth.token.get('email', '').lower() == 'jonathastdsantos@gmail.com' ||
        request.auth.token.get('email', '').lower() == 'jonathas.tdsantos@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ROLE HELPERS ---
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isDev() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('isSuperAdmin', false) == true);
    }

    function isClinicAdmin(clinicId) {
      let user = getUserData();
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        user.clinicId == clinicId && 
        (user.get('role', '') == 'admin' || user.get('role', '') == 'super-admin')
      );
    }

    function isClinicMember(clinicId) {
      let user = getUserData();
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        user.clinicId == clinicId
      );
    }

    // --- VALIDATION HELPERS ---

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'clinicId', 'companyCode', 'role', 'name'])
        && data.email is string && data.email.size() <= 200
        && data.clinicId is string && data.clinicId.size() <= 128
        && data.role in ['admin', 'professional', 'receptionist', 'super-admin']
        && data.name is string && data.name.size() <= 200;
    }

    function isValidClinic(data) {
      return data.keys().hasAll(['name', 'companyCode', 'ownerId', 'specialty', 'createdAt'])
        && data.name is string && data.name.size() <= 200
        && data.companyCode is string && data.companyCode.size() <= 50
        && data.ownerId == request.auth.uid
        && data.specialty in ['dentist', 'medical', 'aesthetic', 'general']
        && data.createdAt == request.time;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['name'])
        && data.name is string && data.name.size() <= 200;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'professionalId', 'startTime', 'endTime', 'status'])
        && data.patientId is string
        && data.professionalId is string
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.status in ['scheduled', 'confirmed', 'completed', 'cancelled', 'no-show'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['type', 'amount', 'date', 'status'])
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.date is timestamp
        && data.status in ['pending', 'received', 'cancelled'];
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin()) 
                   && (isSuperAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'companyCode']));
    }

    match /clinics/{clinicId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow discovery
      allow create: if isSignedIn() && isValidClinic(incoming());
      allow update: if isClinicAdmin(clinicId) && isValidClinic(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'specialty']);

      // SUBCOLLECTIONS
      
      match /patients/{patientId} {
        allow get, list: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId) && isValidPatient(incoming());
        allow update: if isClinicMember(clinicId) && isValidPatient(incoming());
        allow delete: if isClinicAdmin(clinicId);
      }

      match /appointments/{appointmentId} {
        allow get, list: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId) && isValidAppointment(incoming());
        allow update: if isClinicMember(clinicId) && isValidAppointment(incoming());
        allow delete: if isClinicAdmin(clinicId);
      }

      match /healthRecords/{recordId} {
        allow get, list: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId);
        allow update: if isClinicAdmin(clinicId);
      }

      match /transactions/{transactionId} {
        allow get, list: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId) && isValidTransaction(incoming());
        allow update: if isClinicAdmin(clinicId) && isValidTransaction(incoming());
        allow delete: if isClinicAdmin(clinicId);
      }

      match /professionals/{professionalId} {
        allow get, list: if isClinicMember(clinicId);
        allow create, update: if isClinicAdmin(clinicId);
      }
    }
  }
}
